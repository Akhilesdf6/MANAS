                        Spacer(Modifier.height(12.dp))
                        OutlinedButton(onClick = { page = Page.PROGRESS }, modifier = Modifier.fillMaxWidth()) { Text(t("📊 എന്റെ പുരോഗതി", "📊 My progress")) }
                        Spacer(Modifier.height(20.dp))
