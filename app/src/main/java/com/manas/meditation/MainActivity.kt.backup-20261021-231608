"Breathe" -> {
    var breathingActive by remember {
        mutableStateOf(false)
    }

    var cycle by remember {
        mutableIntStateOf(0)
    }

    val transition = rememberInfiniteTransition(
        label = "breathing"
    )

    val animatedSize by transition.animateFloat(
        initialValue = 150f,
        targetValue = 250f,
        animationSpec = infiniteRepeatable(
            animation = tween(
                durationMillis = 4000,
                easing = FastOutSlowInEasing
            ),
            repeatMode = RepeatMode.Reverse
        ),
        label = "breathingSize"
    )

    val circleSize = if(breathingActive) {
        animatedSize.dp
    } else {
        150.dp
    }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .verticalScroll(rememberScrollState())
            .padding(24.dp),
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.Center
    ) {
        Text(
            text = if(language=="ml")
                "ശ്വാസത്തിലേക്ക് ശ്രദ്ധിക്കാം"
            else "Mindful Breathing",
            fontSize = 27.sp,
            fontWeight = FontWeight.Bold,
            color = fg
        )

        Spacer(Modifier.height(14.dp))

        Text(
            text = if(language=="ml")
                "നിങ്ങളുടെ സ്വാഭാവിക താളത്തിൽ ശ്വസിക്കൂ"
            else "Breathe at your natural pace",
            fontSize = 15.sp,
            color = secondary,
            textAlign = TextAlign.Center
        )

        Spacer(Modifier.height(32.dp))

        Box(
            modifier = Modifier
                .fillMaxWidth()
                .height(270.dp),
            contentAlignment = Alignment.Center
        ) {
            Box(
                modifier = Modifier
                    .size(circleSize)
                    .clip(CircleShape)
                    .background(
                        Brush.radialGradient(
                            listOf(
                                Color(0xFFB7A8FF),
                                Color(0xFF7864BC),
                                Color(0xFF403478)
                            )
                        )
                    ),
                contentAlignment = Alignment.Center
            ) {
                Icon(
                    Icons.Default.Air,
                    contentDescription = null,
                    tint = Color.White,
                    modifier = Modifier.size(46.dp)
                )
            }
        }

        Spacer(Modifier.height(20.dp))

        Text(
            text = if(breathingActive) {
                if(language=="ml")
                    "ശ്വാസം സൗമ്യമായി ശ്രദ്ധിക്കൂ"
                else "Follow your natural breath"
