        Text(
            text = if(language=="ml")
                "അസ്വസ്ഥത തോന്നിയാൽ നിർത്തി വിശ്രമിക്കൂ."
            else "If you feel uncomfortable, stop and rest.",
            fontSize = 12.sp,
            color = secondary,
            textAlign = TextAlign.Center
        )
    }
}


